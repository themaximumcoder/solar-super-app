datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Report {
  id           String   @id @default(cuid())
  mhsNumber    String
  customerName String
  address      String
  systemSize   String
  picOnsite    String
  documentUrl  String
  status       String   @default("COMPLETED")
  formData     String?
  createdAt    DateTime @default(now())
  engineerId   String?
  engineer     Engineer? @relation(fields: [engineerId], references: [id])
}

model Engineer {
  id                 String    @id @default(cuid())
  firstName          String
  phone              String
  icNumber           String    @unique
  email              String?   @unique
  password           String
  resetCode          String?
  resetCodeExpiresAt DateTime?
  createdAt          DateTime  @default(now())
  reports            Report[]
  tickets            ConsultationTicket[]
}

model ConsultationTicket {
  id               String    @id @default(cuid())
  customerName     String
  contactInfo      String
  address          String
  issueDescription String
  status           String    @default("OPEN") // OPEN, CLAIMED, RESOLVED
  ticketType       String    @default("CONSULTATION") // CONSULTATION, MAINTENANCE
  scheduledDate    String?
  scheduledTime    String?
  createdAt        DateTime  @default(now())
  
  claimedById      String?
  claimedBy        Engineer? @relation(fields: [claimedById], references: [id])
}

model OfflineSite {
  id        String   @id @default(cuid())
  siteId    String   @unique
  siteName  String
  offlineAt DateTime @default(now())
  resolved  Boolean  @default(false)
}
